  "components": {
    "schemas": {
      "AgencyInfo": {
        "required": [
          "id",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "BrokerClientForm": {
        "required": [
          "form",
          "extraHelpLevel"
        ],
        "type": "object",
        "properties": {
          "form": {
            "$ref": "#/components/schemas/IntakeForm"
          },
          "extraHelpLevel": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "BrokerRole": {
        "enum": [
          "Broker",
          "AgencyAdmin"
        ]
      },
      "CarrierChoice": {
        "required": [
          "parentOrganization",
          "plans",
          "appointed"
        ],
        "type": "object",
        "properties": {
          "parentOrganization": {
            "type": "string"
          },
          "plans": {
            "type": "integer",
            "format": "int32"
          },
          "appointed": {
            "type": "boolean"
          }
        }
      },
      "CarrierSelection": {
        "required": [
          "parentOrganizations"
        ],
        "type": "object",
        "properties": {
          "parentOrganizations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ClientDetail": {
        "required": [
          "id",
          "status",
          "source",
          "form",
          "extraHelpLevel",
          "createdAt",
          "submittedAt",
          "brokerId",
          "brokerName",
          "notes",
          "consents"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "$ref": "#/components/schemas/ClientStatus"
          },
          "source": {
            "$ref": "#/components/schemas/ClientSource"
          },
          "form": {
            "$ref": "#/components/schemas/IntakeForm"
          },
          "extraHelpLevel": {
            "type": "integer",
            "format": "int32"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "submittedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "brokerId": {
            "type": "string",
            "format": "uuid"
          },
          "brokerName": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NoteView"
            }
          },
          "consents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConsentView"
            }
          }
        }
      },
      "ClientSource": {
        "enum": [
          "PublicLink",
          "Invite",
          "Broker"
        ]
      },
      "ClientStatus": {
        "enum": [
          "New",
          "Reviewed",
          "Contacted",
          "Enrolled",
          "Closed"
        ]
      },
      "ClientSummary": {
        "required": [
          "id",
          "name",
          "zip",
          "status",
          "source",
          "isNew",
          "submittedAt",
          "drugCount",
          "brokerId",
          "brokerName"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "zip": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/ClientStatus"
          },
          "source": {
            "$ref": "#/components/schemas/ClientSource"
          },
          "isNew": {
            "type": "boolean"
          },
          "submittedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "drugCount": {
            "type": "integer",
            "format": "int32"
          },
          "brokerId": {
            "type": "string",
            "format": "uuid"
          },
          "brokerName": {
            "type": "string"
          }
        }
      },
      "ConsentKind": {
        "enum": [
          "Contact",
          "ShareHealthInfo"
        ]
      },
      "ConsentTexts": {
        "required": [
          "version",
          "contact",
          "shareHealthInfo"
        ],
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "contact": {
            "type": "string"
          },
          "shareHealthInfo": {
            "type": "string"
          }
        }
      },
      "ConsentView": {
        "required": [
          "kind",
          "textVersion",
          "grantedAt"
        ],
        "type": "object",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/ConsentKind"
          },
          "textVersion": {
            "type": "string"
          },
          "grantedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CountyMatch": {
        "required": [
          "countyCode",
          "countyName",
          "state",
          "share"
        ],
        "type": "object",
        "properties": {
          "countyCode": {
            "type": "string"
